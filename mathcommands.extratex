\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{prop}[theorem]{Proposition}
\newtheorem{cor}[theorem]{Corollary}
\newtheorem{conjecture}[theorem]{Conjecture}

\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{example}[theorem]{Example}
\newtheorem{xca}[theorem]{Övning}

\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}

%\numberwithin{equation}{section}
%\renewcommand{\theequation}{\arabic{subsection}--\arabic{equation}}

\usepackage[toc,page]{appendix}

% Absolutbelopp
\newcommand{\abs}[1]{\left\lvert#1\right\rvert}

% Avrunda uppåt och nedåt
\newcommand{\ceil}[1]{\left\lceil#1\right\rceil}
\newcommand{\floor}[1]{\left\lfloor#1\right\rfloor}

% Nyttiga mängder:
\newcommand{\R}{{\mathbb{R}}}
\newcommand{\Q}{{\mathbb{Q}}}
\newcommand{\N}{{\mathbb{N}}}
\newcommand{\Z}{{\mathbb{Z}}}
\newcommand{\C}{{\mathbb{C}}}
\newcommand{\D}{{\mathcal{D}}}
\newcommand{\M}{{\mathfrak{M}}}
\newcommand{\G}{{\mathcal{G}}}
\newcommand{\calE}{\mathcal{E}}
\newcommand{\calH}{\mathcal{H}}
\newcommand{\Lgr}{\mathcal{L}} % Lagrangian
\newcommand{\Clust}{\mathfrak{C}}
\newcommand{\Pset}{\mathcal{P}}

%Fouriertransform:
\newcommand{\Fou}{\mathscr{F}}

% Punkt som placeholder i funktioner:
\newcommand{\vardot}{\ \cdot\ }

% Väntevärde, varians, sannolikhet, kovarians, indikatorfunktion
\newcommand{\E}[1]{\mathbb{E}\left[ #1 \right]}
\newcommand{\Eover}[2]{\mathbb{E}_{#1}\left[#2\right]}
\newcommand{\bracketE}[1]{\left\langle#1\right\rangle}
\newcommand{\bracketEover}[2]{\left\langle#2\right\rangle_{{#1}}}

\newcommand{\sigmahat}{{\hat{\sigma}}}

\newcommand{\var}[1]{\operatorname{Var}\left(#1\right)}

\newcommand{\Prob}[1]{\mathbb{P}\left( #1 \right)}
\newcommand{\ProbP}{\mathbb{P}}
\newcommand{\ProbOver}[2]{\mathbb{P}_{#1}\left[#2\right]}

\newcommand{\BmannProb}[1]{\mathscr{B}\left(#1\right)}
\newcommand{\BmannProbP}{\mathscr{B}}
\newcommand{\BmannProbOver}[2]{\mathscr{B}_{#1}\left(#2\right)}

\newcommand{\Cov}[2]{\operatorname{Cov}\left(#1,#2\right)}
\newcommand{\Var}[1]{\operatorname{Var}\left(#1\right)}
\newcommand{\Ei}[1]{\operatorname{Ei}\left(#1\right)}
\newcommand{\Dist}{\mathcal{D}'}
\newcommand{\Testf}{\mathcal{D}}

\usepackage{dsfont}
\newcommand{\ind}[1]{\mathds{1}_{#1}}
\newcommand{\given}{\ \middle|\ }

\newcommand{\argmax}{\operatorname{argmax}}

\newcommand{\pivset}{\mathscr{P}}
\newcommand{\specsamp}{\mathscr{S}}

%% Följande kod gör att \Re och \Im inte skrivs med gotiska kapitaler:

\renewcommand{\Re}[1]{\operatorname{Re}(#1)}
\renewcommand{\Im}[1]{\operatorname{Im}(#1)}

%% Skapar ett kommando för komplexa konjugatet och slutna höljet:

\newcommand{\conj}[1]{\overline{#1}}
\newcommand{\close}[1]{\overline{#1}}

%% Skapar ett kommando \grad för graden av ett polynom

\newcommand{\grad}[1]{\nabla#1}

%% Massor av olika differentialer
\newcommand{\df}{\mathrm{d}f}
\newcommand{\dx}{\mathrm{d}x}
\newcommand{\dy}{\mathrm{d}y}
\newcommand{\dz}{\mathrm{d}z}
\newcommand{\dt}{\mathrm{d}t}
\newcommand{\du}{\mathrm{d}u}
\newcommand{\ds}{\mathrm{d}s}
\newcommand{\dmu}{\mathrm{d}\mu} 
\newcommand{\dnu}{\mathrm{d}\nu}
\newcommand{\dxi}{\mathrm{d}\xi}

% Samt för när man vill integrera dgamma eller något
\newcommand{\intd}{\mathrm{d}}

% Svag och vag konvergens av slumpvariabler:
\newcommand{\weakly}{\xrightarrow[]{\text{w.}}}
\newcommand{\vaguely}{\xrightarrow[]{\text{v.}}}

%Inre produkt och norm
\newcommand{\inpr}[2]{\left\langle#1,\,#2\right\rangle}
\newcommand{\norm}[1]{\left\lVert#1\right\rVert}

% Automorfigrupp, identitet, spår av en matris, signum, bild, och spann
\DeclareMathOperator{\Aut}{Aut}
\DeclareMathOperator{\Id}{Id}
\DeclareMathOperator{\tr}{tr}
\DeclareMathOperator{\sgn}{sgn}
\DeclareMathOperator{\im}{im}
\DeclareMathOperator{\lspan}{span}
\DeclareMathOperator{\supp}{supp}
\DeclareMathOperator{\princval}{v.p.}
\DeclareMathOperator{\finpart}{p.f.}
\DeclareMathOperator{\compsupp}{\mathcal{E}}
\DeclareMathOperator{\Ext}{Ext}
\DeclareMathOperator{\Tor}{Tor}
\DeclareMathOperator{\Hom}{Hom}


\newcommand{\blank}{\,\cdot\,}

% Mängddifferens
\newcommand{\setdiff}{\mathbin{\triangle}}

%Logik
\newcommand{\syntequiv}{\equiv}
\newcommand{\semequiv}{\approx}

\newcommand{\proves}{\mathbin{\vdash}}
\newcommand{\entails}{\mathbin{\vDash}}
\newcommand{\intentails}{\mathbin{\Vdash}}

\newcommand{\orl}{\vee}
\newcommand{\andl}{\wedge}
\renewcommand{\implies}{\rightarrow}
\newcommand{\notl}{\neg}
\newcommand{\falsity}{\bot}

\DeclareMathOperator{\Th}{Th}
\DeclareMathOperator{\Mod}{Mod}
\DeclareMathOperator{\dom}{dom}
\DeclareMathOperator{\defin}{def}

\newcommand{\usedrule}[1]{\RightLabel{\scriptsize(#1)}}
\usepackage{bussproofs}

\newcommand{\vertiii}[1]{{\left\vert\kern-0.25ex\left\vert\kern-0.25ex\left\vert #1 
    \right\vert\kern-0.25ex\right\vert\kern-0.25ex\right\vert}}

